# Copy this file to keystore.properties and fill in your private signing values.
# The real keystore and passwords must never be committed.

# Example:
# keytool -genkeypair -v -keystore nuvia-release.jks 
#   -keyalg RSA -keysize 2048 -validity 10000 -alias nuvia

storeFile=nuvia-release.jks
storePassword=
keyAlias=nuvia
keyPassword=
